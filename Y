  "------------------------------------------------------
  " API SO NOTE - Texte d'en-tête ZTM1 pour le BOL
  "------------------------------------------------------
  DATA:
    lv_order_type       TYPE i_salesdocument-salesdocumenttype,
    lv_note_scenario    TYPE c LENGTH 30,
    lv_note_service     TYPE c LENGTH 30,
    lv_note_bol         TYPE string,
    lv_note_xml_before  TYPE string,
    lv_note_xml_after   TYPE string,
    lv_note_xml_tail    TYPE string.

  CLEAR:
    lv_order_type,
    lv_note_bol,
    lv_note_xml_before,
    lv_note_xml_after,
    lv_note_xml_tail,
    lv_response_body,
    lv_url.

  " lv_sdnumber contient déjà la référence SD lue depuis la livraison.
  IF lv_sdnumber IS NOT INITIAL.

    SELECT SINGLE salesdocumenttype
      FROM i_salesdocument
      WHERE salesdocument = @lv_sdnumber
      INTO @lv_order_type.

    IF lv_order_type = 'CBFD'.
      lv_note_scenario = 'YY1_INT1_HTTP'.
      lv_note_service  = 'YY1_SO_SANSFRAIS1_REST'.

      lv_url =
        |/API_SALES_ORDER_WITHOUT_CHARGE_SRV/A_SlsOrdWthoutChrgText| &&
        |?$filter=SalesOrderWithoutCharge eq '{ lv_sdnumber }'| &&
        | and LongTextID eq 'ZTM1'|.
    ELSE.
      lv_note_scenario = 'YY1_INT_HTTP'.
      lv_note_service  = 'YY1_SALESORDERNOTE_REST'.

      lv_url =
        |/A_SalesOrderText?$filter=SalesOrder eq '{ lv_sdnumber }'| &&
        | and LongTextID eq 'ZTM1'|.
    ENDIF.

    TRY.
        IF cl_ble_http_client=>is_service_available(
             communication_scenario = lv_note_scenario
             outbound_service       = lv_note_service
           ) = abap_true.

          DATA(lo_note_client) = cl_ble_http_client=>create(
            communication_scenario = lv_note_scenario
            outbound_service       = lv_note_service
          ).

          DATA(lo_note_request) = cl_ble_http_request=>create( ).
          lo_note_request->set_method( 'GET' )->set_resource_extension( lv_url ).

          DATA(lo_note_response) = lo_note_client->send( lo_note_request ).
          lv_response_body = lo_note_response->get_body( ).

          IF lv_response_body CS '<d:LongText>'
             AND lv_response_body CS '</d:LongText>'.

            SPLIT lv_response_body AT '<d:LongText>'
              INTO lv_note_xml_before lv_note_xml_after.

            SPLIT lv_note_xml_after AT '</d:LongText>'
              INTO lv_note_bol lv_note_xml_tail.

            CONDENSE lv_note_bol.

            IF lv_note_bol IS NOT INITIAL.
              <transp_order_out>-yy1_notebol_tor = lv_note_bol.
            ENDIF.

          ENDIF.
        ENDIF.

      CATCH cx_ble_http_exception INTO DATA(lx_note_exception).
        " Laisser la valeur de sortie existante si l'appel échoue.
    ENDTRY.

  ENDIF.
